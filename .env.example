# ---------------------------------------------------------------------------
# Rooster Tree - Lawn Services — environment variables
# Copy this file to `.env.local` and fill in the values. NEVER commit .env files.
#
# Every value below is specific to Rooster. Do not reuse an API key, recipient
# address or domain from any other project.
# ---------------------------------------------------------------------------

# Resend API key — required for the Free Estimate form to send email.
# Create one at https://resend.com/api-keys  (starts with "re_")
RESEND_API_KEY=

# REQUIRED. Where Free Estimate submissions are delivered — the business
# inbox for Rooster Tree - Lawn Services. Without it the form returns a
# "please call us" message in production instead of silently dropping leads.
CONTACT_TO_EMAIL=

# Sender address shown in the email "From" field.
# For testing you can use onboarding@resend.dev.
# For production, verify the Rooster domain in Resend and use something like:
#   estimates@roosterserviceshtx.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Public site URL (used for canonical/OG metadata and sitemap.xml).
# Update this to the real domain before launch.
NEXT_PUBLIC_SITE_URL=https://roosterserviceshtx.com
